<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusBite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusBite.Views"
    Title="CampusBite">

    <TabBar>
        <ShellContent
            Title="Cafés"
            ContentTemplate="{DataTemplate views:CafeListPage}"
            Route="CafeListPage" />

        <ShellContent
            Title="Cart"
            ContentTemplate="{DataTemplate views:CartPage}"
            Route="CartPage" />

        <ShellContent
            Title="Orders"
            ContentTemplate="{DataTemplate views:OrderHistoryPage}"
            Route="OrderHistoryPage" />

        <ShellContent
            Title="Admin"
            ContentTemplate="{DataTemplate views:CafeAdminPage}"
            Route="CafeAdminPage" />
    </TabBar>

</Shell>
