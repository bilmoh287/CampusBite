<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             x:Class="CampusBite.Views.OrderDetailsPage"
             x:DataType="vm:OrderDetailsViewModel"
             Title="Order Receipt 🧾"
             BackgroundColor="#121212">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="20">

            <!-- Receipt Header Card -->
            <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Order.Id, StringFormat='Order #{0}'}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="{Binding FormattedDate}" FontSize="13" TextColor="#AAAAAA"/>
                        </VerticalStackLayout>

                        <Border Grid.Column="1" BackgroundColor="#2C2415" StrokeThickness="1" Stroke="#FF9800" Padding="12,4" VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding Order.Status}" FontSize="13" FontAttributes="Bold" TextColor="#FF9800"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#333333"/>

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="Order Type" FontSize="13" TextColor="#888888"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Order.OrderType}" FontSize="13" FontAttributes="Bold" TextColor="White"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Total Items" FontSize="13" TextColor="#888888"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ItemCount, StringFormat='{0} items'}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Itemized Table Card -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Item Breakdown" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <!-- Safe BindableLayout inside ScrollView -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Order.OrderItems}" Spacing="4">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OrderItem">
                                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,6" ColumnSpacing="12">
                                        <Label Grid.Column="0" Text="{Binding Product.Name, FallbackValue='Campus Meal'}" FontSize="14" TextColor="White" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="14" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding UnitPrice, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#FF9800" VerticalOptions="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#333333"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total Paid" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding Order.TotalAmount, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="#FF9800" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
