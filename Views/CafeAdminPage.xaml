<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             xmlns:dto="clr-namespace:CampusBite.DTOs"
             x:Class="CampusBite.Views.CafeAdminPage"
             x:DataType="vm:CafeAdminViewModel"
             Title="Staff Dashboard ⚙️"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Header & Cafe Selector Bar -->
        <Border Grid.Row="0" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Cafe Admin Dashboard" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Manage live orders and advance kitchen status." FontSize="12" TextColor="#AAAAAA"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="🔄 Refresh"
                            Command="{Binding LoadAdminDataCommand}"
                            BackgroundColor="#2C2C2C"
                            TextColor="#FF9800"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- Cafe Picker Container -->
                <Border BackgroundColor="#2C2C2C" StrokeThickness="1" Stroke="#444444" Padding="12,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Picker ItemsSource="{Binding Cafes}"
                            SelectedItem="{Binding SelectedCafe}"
                            ItemDisplayBinding="{Binding Name}"
                            Title="Select Active Cafe"
                            TextColor="White"
                            TitleColor="#AAAAAA"
                            FontSize="14"/>
                </Border>

                <!-- Cafe Status Toggle Card -->
                <Border BackgroundColor="#222222" StrokeThickness="1" Stroke="#333333" Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="Café Status:" FontSize="13" TextColor="#AAAAAA" VerticalOptions="Center"/>
                            <Border StrokeShape="RoundRectangle 10" Padding="8,2" StrokeThickness="0">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCafeOpen}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1A3826"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsCafeOpen}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#3D1A1A"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label FontSize="11" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCafeOpen}" Value="True">
                                            <Setter Property="Text" Value="OPEN"/>
                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCafeOpen}" Value="False">
                                            <Setter Property="Text" Value="CLOSED"/>
                                            <Setter Property="TextColor" Value="#F44336"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Toggle Switch -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="Accepting Orders" FontSize="12" TextColor="#888888" VerticalOptions="Center"/>
                            <Switch IsToggled="{Binding IsCafeOpen}"
                                    OnColor="#4CAF50"
                                    ThumbColor="White"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Cafe Broadcast Announcement Card -->
                <Border BackgroundColor="#222222" StrokeThickness="1" Stroke="#333333" Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="📢 Broadcast Notice:" FontSize="13" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                <Label Text="(Student Menu Banner)" FontSize="11" TextColor="#666666" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Clear ✕"
                                    Command="{Binding ClearAnnouncementCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF6B6B"
                                    FontSize="11"
                                    Padding="8,2"
                                    HeightRequest="28"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="#161616" StrokeThickness="1" Stroke="#444444" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding AnnouncementText}"
                                       Placeholder="e.g. 20% off all pastries after 3 PM!"
                                       PlaceholderColor="#666666"
                                       TextColor="White"
                                       FontSize="13"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Broadcast 🚀"
                                    Command="{Binding SaveAnnouncementCommand}"
                                    BackgroundColor="#FF9800"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="6"
                                    Padding="14,0"
                                    HeightRequest="40"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Section Switcher Tabs (Native Buttons for robust WinUI 3 pointer handling) -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <!-- Live Orders Tab Button -->
                    <Button Grid.Column="0"
                            Text="🎫 Tickets"
                            Command="{Binding SwitchSectionCommand}"
                            CommandParameter="Orders"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="42">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOrdersSectionActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF9800"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsOrdersSectionActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="#222222"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Menu & Stock Tab Button -->
                    <Button Grid.Column="1"
                            Text="🍔 Stock"
                            Command="{Binding SwitchSectionCommand}"
                            CommandParameter="Stock"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="42">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsStockSectionActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF9800"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsStockSectionActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="#222222"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Sales & Analytics Tab Button -->
                    <Button Grid.Column="2"
                            Text="📊 Sales"
                            Command="{Binding SwitchSectionCommand}"
                            CommandParameter="Sales"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="42">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSalesSectionActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF9800"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSalesSectionActive}" Value="False">
                                <Setter Property="BackgroundColor" Value="#222222"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- SECTION 1: Orders View (Tab 1) -->
        <Grid Grid.Row="1" IsVisible="{Binding IsOrdersSectionActive}">

            <!-- Orders Collection -->
            <CollectionView ItemsSource="{Binding IncomingOrders}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12"
                                         Padding="30">
                        <Label Text="👨‍🍳" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="No Active Orders" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="When students place food orders for this cafe, tickets will appear here for staff preparation."
                               FontSize="14"
                               TextColor="#888888"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,12" Spacing="8">
                        <Label Text="Incoming Campus Tickets" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Grid Padding="16,6">
                            <Border BackgroundColor="#1E1E1E"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="12">
                                    <!-- Header Row -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Id, StringFormat='Ticket #{0}'}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="{Binding OrderType, StringFormat='• {0}'}" FontSize="13" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding OrderDate, StringFormat='{0:g}'}" FontSize="12" TextColor="#777777"/>
                                        </VerticalStackLayout>

                                        <!-- Status Pill -->
                                        <Border Grid.Column="1" BackgroundColor="#2C2415" StrokeThickness="1" Stroke="#FF9800" Padding="10,4">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="Stroke" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="BackgroundColor" Value="#3D1A1A"/>
                                                    <Setter Property="Stroke" Value="#F44336"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="#FF9800">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="TextColor" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="TextColor" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#2A2A2A"/>

                                    <!-- Delivery Location Badge (Visible for Delivery Orders) -->
                                    <Border BackgroundColor="#1E2A38"
                                            Stroke="#2196F3"
                                            StrokeThickness="1"
                                            Padding="8,4"
                                            IsVisible="{Binding HasDeliveryLocation}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="📍" FontSize="11" VerticalOptions="Center"/>
                                            <Label Text="Drop-off:" FontSize="11" FontAttributes="Bold" TextColor="#2196F3" VerticalOptions="Center"/>
                                            <Label Text="{Binding DeliveryLocation}" FontSize="12" TextColor="White" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Special Kitchen Notes Badge -->
                                    <Border BackgroundColor="#2D2B1E"
                                            Stroke="#FFC107"
                                            StrokeThickness="1"
                                            Padding="8,4"
                                            IsVisible="{Binding HasNotes}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="📝" FontSize="11" VerticalOptions="Center"/>
                                            <Label Text="Note:" FontSize="11" FontAttributes="Bold" TextColor="#FFC107" VerticalOptions="Center"/>
                                            <Label Text="{Binding Notes}" FontSize="12" TextColor="#CCCCCC" FontAttributes="Italic" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Items List Preview using BindableLayout (WinUI Safe) -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrderItems}" Spacing="3">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:OrderItem">
                                                <Grid ColumnDefinitions="*, Auto" Padding="0,3">
                                                    <Label Grid.Column="0" Text="{Binding Product.Name, FallbackValue='Meal Item'}" FontSize="13" TextColor="#CCCCCC"/>
                                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="13" FontAttributes="Bold" TextColor="#FF9800"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="1" Color="#2A2A2A"/>

                                    <!-- Bottom Action Row -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Total Amount" FontSize="11" TextColor="#888888"/>
                                            <Label Text="{Binding TotalAmount, StringFormat='${0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                            <!-- Cancel Ticket Button (Only visible if order is not completed/cancelled) -->
                                            <Button Text="Cancel ✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=CancelOrderCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding CanBeCancelled}"
                                                    BackgroundColor="#2D1B1B"
                                                    TextColor="#FF6B6B"
                                                    FontAttributes="Bold"
                                                    CornerRadius="14"
                                                    Padding="12,6"
                                                    FontSize="11"/>

                                            <!-- Advance Ticket Status Button -->
                                            <Button Text="Advance Status ⚡"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=AdvanceStatusCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FF9800"
                                                    TextColor="Black"
                                                    FontAttributes="Bold"
                                                    CornerRadius="14"
                                                    Padding="14,6"
                                                    FontSize="11">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Text" Value="Completed ✔️"/>
                                                        <Setter Property="BackgroundColor" Value="#2E7D32"/>
                                                        <Setter Property="TextColor" Value="White"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Text" Value="Cancelled ✕"/>
                                                        <Setter Property="BackgroundColor" Value="#3D2020"/>
                                                        <Setter Property="TextColor" Value="#FF6B6B"/>
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- SECTION 2: Menu & Stock Control View (Tab 2) -->
        <Grid Grid.Row="1" IsVisible="{Binding IsStockSectionActive}">

            <!-- Products Collection (Direct child of RefreshView, WinUI safe) -->
            <CollectionView ItemsSource="{Binding CafeProducts}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12"
                                         Padding="30">
                        <Label Text="📦" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="No Menu Items Found" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="No products found for this cafe in the campus database."
                               FontSize="14"
                               TextColor="#888888"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,12" Spacing="4">
                        <Label Text="Live Stock &amp; Availability" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                        <Label Text="Tap the availability button to mark items sold out or back in stock in real time." FontSize="12" TextColor="#888888"/>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Grid Padding="16,6">
                            <Border BackgroundColor="#1E1E1E"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                    <!-- Product Thumbnail -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 8"
                                            HeightRequest="48"
                                            WidthRequest="48"
                                            BackgroundColor="#2A2A2A"
                                            Padding="6"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFit"/>
                                    </Border>

                                    <!-- Product Details -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Category}" FontSize="11" TextColor="#FF9800" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Label Text="•" FontSize="11" TextColor="#666666" VerticalOptions="Center"/>
                                            
                                            <!-- Interactive Price Pill with Edit Prompt -->
                                            <Border BackgroundColor="#2A2A2A"
                                                    Stroke="#444444"
                                                    StrokeThickness="1"
                                                    Padding="8,2"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6"/>
                                                </Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=EditProductPriceCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#4CAF50"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="✏️" FontSize="10" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Column 2: Availability & Optional Stock Stepper -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                        <!-- Primary Toggle Pill (Cook's 1-Tap In Stock / Sold Out) -->
                                        <Border StrokeThickness="1"
                                                Padding="10,6"
                                                HorizontalOptions="End"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14"/>
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=ToggleProductAvailabilityCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="Stroke" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="#3D1A1A"/>
                                                    <Setter Property="Stroke" Value="#F44336"/>
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <HorizontalStackLayout Spacing="4">
                                                <Label FontSize="12">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Text" Value="✅"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Text" Value="❌"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Text" Value="IN STOCK"/>
                                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Text" Value="SOLD OUT"/>
                                                            <Setter Property="TextColor" Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- Optional Numeric Stepper (Only visible when cook tracks units) -->
                                        <HorizontalStackLayout Spacing="4" HorizontalOptions="End" IsVisible="{Binding HasTrackedStock}">
                                            <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=DecreaseStockCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="-" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                            </Border>

                                            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=EditStockCountCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding StockQuantity, StringFormat='{0} left'}" FontSize="10" TextColor="#CCCCCC" VerticalOptions="Center"/>
                                            </Border>

                                            <Border BackgroundColor="#2A2A2A" Stroke="#444444" StrokeThickness="1" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=IncreaseStockCommand}"
                                                                          CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="+" FontSize="12" FontAttributes="Bold" TextColor="White"/>
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Low Stock Warning Pill -->
                                        <Border BackgroundColor="#2C2415" Stroke="#FF9800" StrokeThickness="1" Padding="6,1" HorizontalOptions="End" IsVisible="{Binding IsLowStock}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                            <Label Text="⚠️ Low Stock" FontSize="9" FontAttributes="Bold" TextColor="#FF9800"/>
                                        </Border>

                                        <!-- Optional Count Activation Link (When untracked) -->
                                        <Label Text="+ Track Qty"
                                               FontSize="10"
                                               TextColor="#666666"
                                               HorizontalOptions="End">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=EditStockCountCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasTrackedStock}" Value="True">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- SECTION 3: Sales & Business Analytics (Tab 3) -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsSalesSectionActive}">
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header Row with Manual Recalculate Button -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Revenue &amp; Performance" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Live operational insights and sales metrics." FontSize="12" TextColor="#AAAAAA"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Recalculate ⚡"
                            Command="{Binding ComputeSalesMetricsCommand}"
                            BackgroundColor="#2C2C2C"
                            TextColor="#FF9800"
                            FontAttributes="Bold"
                            FontSize="11"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- KPI Metric Cards Grid (2x2) -->
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                    <!-- Today's Gross Revenue Card -->
                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#2E7D32" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="💵 TODAY'S SALES" FontSize="11" FontAttributes="Bold" TextColor="#4CAF50"/>
                            <Label Text="{Binding TodayRevenue, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Completed/Active" FontSize="10" TextColor="#777777"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Monthly Revenue Card -->
                    <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#FF9800" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📅 THIS MONTH" FontSize="11" FontAttributes="Bold" TextColor="#FF9800"/>
                            <Label Text="{Binding MonthRevenue, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Calendar month gross" FontSize="10" TextColor="#777777"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Completed Orders Count Card -->
                    <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#2196F3" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="📦 ORDERS FULFILLED" FontSize="11" FontAttributes="Bold" TextColor="#2196F3"/>
                            <Label Text="{Binding TotalCompletedOrders}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Total delivered/ready" FontSize="10" TextColor="#777777"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Average Ticket Size Card -->
                    <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#9C27B0" Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🧾 AVG TICKET" FontSize="11" FontAttributes="Bold" TextColor="#BA68C8"/>
                            <Label Text="{Binding AverageTicketValue, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Per order average" FontSize="10" TextColor="#777777"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Net Profit & Bottom Line Card -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#444444" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Monthly Profit &amp; Loss" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                            <Border Grid.Column="1" StrokeThickness="0" Padding="8,3" BackgroundColor="#2A2A2A">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                <Label Text="{Binding ProfitMarginPercent, StringFormat='{0:F1}% Margin'}" FontSize="11" FontAttributes="Bold" TextColor="#FF9800"/>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                            <!-- Gross Sales -->
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Gross Revenue" FontSize="10" TextColor="#AAAAAA"/>
                                <Label Text="{Binding MonthRevenue, StringFormat='${0:F2}'}" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>

                            <!-- Total Expenses -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Expenses" FontSize="10" TextColor="#AAAAAA"/>
                                <Label Text="{Binding MonthExpenses, StringFormat='-${0:F2}'}" FontSize="15" FontAttributes="Bold" TextColor="#FF6B6B"/>
                            </VerticalStackLayout>

                            <!-- Net Profit -->
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Net Profit" FontSize="10" TextColor="#AAAAAA"/>
                                <Label Text="{Binding NetProfit, StringFormat='${0:F2}'}" FontSize="16" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsProfitable}" Value="True">
                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsProfitable}" Value="False">
                                            <Setter Property="TextColor" Value="#FF5252"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Operating Expenses Tracker Card -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Operating Expenses 🧾" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Track ingredients, packaging, and supply costs." FontSize="11" TextColor="#888888"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Log Expense"
                                    Command="{Binding LogExpenseCommand}"
                                    BackgroundColor="#FF9800"
                                    TextColor="Black"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    CornerRadius="8"
                                    Padding="10,6"
                                    HeightRequest="36"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <!-- Fallback Empty State when no expenses -->
                        <VerticalStackLayout Spacing="6" Padding="12" HorizontalOptions="Center" IsVisible="{Binding HasNoExpenses}">
                            <Label Text="📦" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="No expenses logged yet for this café." FontSize="12" TextColor="#888888" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Expenses List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CafeExpenses}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Expense">
                                    <Border BackgroundColor="#242424" StrokeThickness="0" Padding="12,8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                                            <!-- Title & Category -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Category}" FontSize="10" TextColor="#FF9800"/>
                                                    <Label Text="•" FontSize="10" TextColor="#666666"/>
                                                    <Label Text="{Binding ExpenseDate, StringFormat='{0:M/d}'}" FontSize="10" TextColor="#888888"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Amount -->
                                            <Label Grid.Column="1"
                                                   Text="{Binding Amount, StringFormat='-${0:F2}'}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#FF6B6B"
                                                   VerticalOptions="Center"/>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeAdminViewModel}}, Path=DeleteExpenseCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#777777"
                                                    FontSize="12"
                                                    Padding="6,2"
                                                    HeightRequest="30"
                                                    WidthRequest="30"
                                                    VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Order Channel Breakdown Card -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Fulfillment Channels" FontSize="14" FontAttributes="Bold" TextColor="White"/>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- Pickup Box -->
                            <Border Grid.Column="0" BackgroundColor="#242424" StrokeThickness="1" Stroke="#444444" Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="🚶" FontSize="24" VerticalOptions="Center"/>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="Campus Pickup" FontSize="11" TextColor="#AAAAAA"/>
                                        <Label Text="{Binding PickupOrderCount, StringFormat='{0} orders'}" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Delivery Box -->
                            <Border Grid.Column="1" BackgroundColor="#242424" StrokeThickness="1" Stroke="#444444" Padding="12">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="🛵" FontSize="24" VerticalOptions="Center"/>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="Dorm Delivery" FontSize="11" TextColor="#AAAAAA"/>
                                        <Label Text="{Binding DeliveryOrderCount, StringFormat='{0} orders'}" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Top Selling Items Leaderboard -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Top 5 Best Sellers 🏆" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                            <Label Grid.Column="1" Text="By Units Sold" FontSize="11" TextColor="#FF9800"/>
                        </Grid>

                        <!-- Fallback Empty State when no orders -->
                        <VerticalStackLayout Spacing="6" Padding="12" HorizontalOptions="Center" IsVisible="{Binding HasNoSalesData}">
                            <Label Text="📊" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="No sales recorded yet." FontSize="12" TextColor="#888888" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Leaderboard Items List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopSellingItems}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:TopSellingItemDto">
                                    <Border BackgroundColor="#252525" StrokeThickness="0" Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="{Binding QuantitySold, StringFormat='{0} units sold'}" FontSize="11" TextColor="#FF9800"/>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                                <Label Text="{Binding TotalRevenue, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="End"/>
                                                <Label Text="revenue" FontSize="9" TextColor="#777777" HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
