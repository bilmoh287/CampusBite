<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             x:Class="CampusBite.Views.CafeMenuPage"
             x:DataType="vm:CafeMenuViewModel"
             Title="{Binding Cafe.Name, FallbackValue='Café Menu'}"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top Café Header Banner -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15" Spacing="4" BackgroundColor="#512BD4">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Cafe.Name}" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White" />

                <!-- Café Open / Closed Status -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="8,3"
                        StrokeThickness="0">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Cafe.IsOpen}" Value="True">
                            <Setter Property="BackgroundColor" Value="#E6F4EA" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Cafe.IsOpen}" Value="False">
                            <Setter Property="BackgroundColor" Value="#FCE8E6" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label FontSize="11" FontAttributes="Bold">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Cafe.IsOpen}" Value="True">
                                <Setter Property="Text" Value="OPEN" />
                                <Setter Property="TextColor" Value="#137333" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Cafe.IsOpen}" Value="False">
                                <Setter Property="Text" Value="CLOSED" />
                                <Setter Property="TextColor" Value="#C5221F" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </Grid>

            <Label Text="{Binding Cafe.Description}" 
                   FontSize="12" 
                   TextColor="#E0D0FF" 
                   MaxLines="2" />

            <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                <Label Text="📍" FontSize="11" />
                <Label Text="{Binding Cafe.Location}" FontSize="11" TextColor="#D1C4E9" FontAttributes="Italic" />
            </HorizontalStackLayout>

            <!-- Announcement Broadcast Banner -->
            <Border IsVisible="{Binding HasAnnouncement}"
                    BackgroundColor="#2B1D00"
                    Stroke="#FF9800"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,8"
                    Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0" Text="📢" FontSize="14" VerticalOptions="Center" Margin="0,0,8,0"/>
                    <Label Grid.Column="1" 
                           Text="{Binding Announcement}" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#FFE082" 
                           VerticalOptions="Center" 
                           LineBreakMode="WordWrap"/>
                </Grid>
            </Border>

            <!-- Closed Warning Banner -->
            <Border IsVisible="{Binding IsCafeClosed}"
                    BackgroundColor="#3D1A1A"
                    Stroke="#F44336"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10,6"
                    Margin="0,8,0,0">
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="⚠️" FontSize="12" VerticalOptions="Center"/>
                    <Label Text="This café is currently closed. Browsing menu only." FontSize="12" FontAttributes="Bold" TextColor="#FFCDD2" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Horizontal Category Filter Chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="15,10">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border StrokeShape="RoundRectangle 16"
                                Padding="14,8"
                                StrokeThickness="1">
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeMenuViewModel}}, Path=FilterByCategoryCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <!-- Style Active vs Inactive Category Pills -->
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding .}" Value="All">
                                    <Setter Property="BackgroundColor" Value="#512BD4" />
                                    <Setter Property="Stroke" Value="#512BD4" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Label Text="{Binding .}" FontSize="13" FontAttributes="Bold" TextColor="#333333">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding .}" Value="All">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Products Collection List -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding LoadMenuCommand}">
            
            <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="30">
                        <Label Text="No Menu Items Available" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Try selecting a different category or pull down to refresh" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Grid Padding="15,6">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="15">

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                        <Setter Property="BackgroundColor" Value="#FAFAFA" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeMenuViewModel}}, Path=SelectProductCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">

                                    <!-- Product Thumbnail -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            HeightRequest="60"
                                            WidthRequest="60"
                                            BackgroundColor="#F0EBFF"
                                            Padding="8"
                                            StrokeThickness="0">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFit" />
                                    </Border>

                                    <!-- Product Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#1F1F1F" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="#666666" MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Category}" FontSize="11" TextColor="#512BD4" FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <!-- Product Price & Availability Badge -->
                                    <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="{Binding Price, StringFormat='${0:F2}'}" 
                                               FontSize="15" 
                                               FontAttributes="Bold" 
                                               TextColor="#1F1F1F" 
                                               HorizontalOptions="End" />

                                        <Border StrokeShape="RoundRectangle 10" Padding="6,2" StrokeThickness="0" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#E6F4EA" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsAvailable}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="#FCE8E6" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label FontSize="10" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="True">
                                                        <Setter Property="Text" Value="Available" />
                                                        <Setter Property="TextColor" Value="#137333" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Text" Value="Sold Out" />
                                                        <Setter Property="TextColor" Value="#C5221F" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>

                                </Grid>

                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
