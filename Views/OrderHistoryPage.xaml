<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             x:Class="CampusBite.Views.OrderHistoryPage"
             x:DataType="vm:OrderHistoryViewModel"
             Title="My Orders 📋"
             BackgroundColor="#121212">

    <Grid>
        <!-- Pull to Refresh Container -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadOrdersCommand}"
                     RefreshColor="#FF9800"
                     BackgroundColor="#121212">

            <!-- Orders List (Direct child of RefreshView, WinUI safe) -->
            <CollectionView ItemsSource="{Binding Orders}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12"
                                         Padding="30">
                        <Label Text="📋" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="No Orders Yet" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="When you place an order from campus cafes, your receipts and order tracking will appear right here."
                               FontSize="14"
                               TextColor="#888888"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="16,16,16,8" Spacing="16">
                            <!-- Page Title -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Orders &amp; Spending 📊" FontSize="22" FontAttributes="Bold" TextColor="White"/>
                                <Label Text="Track ongoing orders and monitor your monthly dining allowance." FontSize="13" TextColor="#AAAAAA"/>
                            </VerticalStackLayout>

                            <!-- Monthly Budget & Spending Card -->
                            <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <!-- Card Header Row -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Label Text="🎯" FontSize="16" VerticalOptions="Center"/>
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Monthly Food Budget" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="Student Allowance Tracker" FontSize="11" TextColor="#888888"/>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Edit Budget ✏️"
                                                Command="{Binding SetBudgetCommand}"
                                                BackgroundColor="#2A2A2A"
                                                TextColor="#FF9800"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                Padding="10,4"
                                                HeightRequest="32"
                                                VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Stat Summary Row -->
                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                        <Border Grid.Column="0" BackgroundColor="#141414" StrokeThickness="1" Stroke="#2A2A2A" Padding="12,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Spent This Month" FontSize="11" TextColor="#888888"/>
                                                <Label Text="{Binding CurrentMonthSpent, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="1" BackgroundColor="#141414" StrokeThickness="1" Stroke="#2A2A2A" Padding="12,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Remaining Allowance" FontSize="11" TextColor="#888888"/>
                                                <Label Text="{Binding RemainingBudget, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#4CAF50"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Progress Bar & Status -->
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding BudgetStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding BudgetProgressColor}"/>
                                            <Label Grid.Column="1" Text="{Binding BudgetPercentText, StringFormat='{0} used'}" FontSize="12" TextColor="#AAAAAA"/>
                                        </Grid>

                                        <ProgressBar Progress="{Binding BudgetProgress}"
                                                     ProgressColor="{Binding BudgetProgressColor}"
                                                     BackgroundColor="#2A2A2A"
                                                     HeightRequest="8"/>
                                    </VerticalStackLayout>

                                    <!-- Bottom Info: Target Budget & All-time Spend -->
                                    <Grid ColumnDefinitions="*, Auto" Padding="2,2,2,0">
                                        <Label Grid.Column="0" Text="{Binding MonthlyBudget, StringFormat='Target Budget: ${0:F2}'}" FontSize="11" TextColor="#777777"/>
                                        <Label Grid.Column="1" Text="{Binding TotalSpentAllTime, StringFormat='All-Time: ${0:F2}'}" FontSize="11" TextColor="#777777"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Section Header for Order Cards -->
                            <Label Text="Recent Orders" FontSize="16" FontAttributes="Bold" TextColor="#FF9800" Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Order">
                            <Grid Padding="16,6">
                                <Border BackgroundColor="#1E1E1E"
                                        StrokeThickness="1"
                                        Stroke="#333333"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OrderHistoryViewModel}}, Path=SelectOrderCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="10">
                                        <!-- Top Row: Order ID & Status Badge -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding Id, StringFormat='Order #{0}'}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="{Binding OrderType, StringFormat='• {0}'}" FontSize="14" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="1" BackgroundColor="#2C2415" StrokeThickness="1" Stroke="#FF9800" Padding="8,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#FF9800"/>
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#2A2A2A"/>

                                        <!-- Middle Row: Timestamp & Total -->
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding OrderDate, StringFormat='{0:g}'}" FontSize="13" TextColor="#888888" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#FF9800" VerticalOptions="Center"/>
                                        </Grid>

                                        <Label Text="Tap to view itemized receipt →" FontSize="12" TextColor="#FF9800" HorizontalOptions="End"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
