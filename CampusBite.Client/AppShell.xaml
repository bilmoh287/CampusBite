<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CampusBite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CampusBite.Views"
    Title="CampusBite">

    <!-- Auth Flow (Hidden from main tabs) -->
    <ShellItem Route="LoginPage" FlyoutItemIsVisible="False">
        <ShellContent
            Title="Sign In"
            ContentTemplate="{DataTemplate views:LoginPage}"
            Route="LoginPage" />
    </ShellItem>

    <!-- Main Navigation TabBar for Authenticated Users -->
    <TabBar x:Name="AppTabBar" Route="Main">
        <ShellContent
            x:Name="CafesTab"
            Title="Cafés"
            ContentTemplate="{DataTemplate views:CafeListPage}"
            Route="CafeListPage" />

        <ShellContent
            x:Name="CartTab"
            Title="Cart"
            ContentTemplate="{DataTemplate views:CartPage}"
            Route="CartPage" />

        <ShellContent
            x:Name="OrdersTab"
            Title="Orders"
            ContentTemplate="{DataTemplate views:OrderHistoryPage}"
            Route="OrderHistoryPage" />

        <ShellContent
            x:Name="CourierTab"
            Title="Courier"
            ContentTemplate="{DataTemplate views:DeliveryRunnerPage}"
            Route="DeliveryRunnerPage" />

        <ShellContent
            x:Name="AdminTab"
            Title="Admin"
            ContentTemplate="{DataTemplate views:CafeAdminPage}"
            Route="CafeAdminPage" />
    </TabBar>

</Shell>
