<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:dto="clr-namespace:CampusBite.Shared.DTOs;assembly=CampusBite.Shared"
             x:Class="CampusBite.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Create Account"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <!-- Header Banner -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,10,0,10">
                <Label Text="Join CampusBite"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center" />
                <Label Text="Order ahead, deliver, or run your campus café"
                       FontSize="13"
                       TextColor="#666666"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#FFCDD2"
                    BackgroundColor="#FFEBEE"
                    Padding="12"
                    StrokeThickness="1">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#C62828"
                           FontSize="13"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap" />
                </HorizontalStackLayout>
            </Border>

            <!-- Registration Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20">
                <VerticalStackLayout Spacing="14">

                    <!-- Role Selector -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="I am joining as a:"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#512BD4"
                                StrokeThickness="1.5"
                                Padding="12,2"
                                BackgroundColor="#F5F0FF">
                            <Picker ItemsSource="{Binding Roles}"
                                    SelectedItem="{Binding SelectedRole}"
                                    TextColor="#512BD4"
                                    FontAttributes="Bold"
                                    FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campus / University Selection (Shown for Students) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsStudent}">
                        <Label Text="Select Campus / University"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,2">
                            <Picker ItemsSource="{Binding Universities}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedUniversity}"
                                    Title="Select your university"
                                    FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Full Name"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding FullName}"
                                   TextColor="#1A1A1A"
                                   PlaceholderColor="#888888"
                                   Placeholder="e.g. Abebe Bikila"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding Email}"
                                   TextColor="#1A1A1A"
                                   PlaceholderColor="#888888"
                                   Placeholder="name@campus.edu"
                                   Keyboard="Email"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password (min 6 characters)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding Password}"
                                   TextColor="#1A1A1A"
                                   PlaceholderColor="#888888"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Phone Number -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Phone Number (Optional)"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding PhoneNumber}"
                                   TextColor="#1A1A1A"
                                   PlaceholderColor="#888888"
                                   Placeholder="+251 911 234567"
                                   Keyboard="Telephone"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Register Button -->
                    <Button Text="Create Account"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,10,0,0" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#512BD4"
                                       HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Already Have Account Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,5,0,25">
                <Label Text="Already have an account?"
                       FontSize="14"
                       TextColor="#666666" />
                <Label Text="Sign In"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#512BD4">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
