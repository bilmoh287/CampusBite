<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             x:Class="CampusBite.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Sign In"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- App Logo / Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,20,0,10">
                <Border StrokeShape="RoundRectangle 24"
                        BackgroundColor="#512BD4"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        StrokeThickness="0">
                    <Label Text="🍔"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <Label Text="CampusBite"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       HorizontalOptions="Center" />

                <Label Text="Campus food ordering &amp; courier dispatch"
                       FontSize="14"
                       TextColor="#666666"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#FFCDD2"
                    BackgroundColor="#FFEBEE"
                    Padding="12"
                    StrokeThickness="1">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#C62828"
                           FontSize="13"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap" />
                </HorizontalStackLayout>
            </Border>

            <!-- Login Form Card -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20">
                <VerticalStackLayout Spacing="16">

                    <!-- Email Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email Address"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding Email}"
                                   Placeholder="student@aau.edu.et"
                                   Keyboard="Email"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Input -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                StrokeThickness="1"
                                Padding="12,4">
                            <Entry Text="{Binding Password}"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Sign In Button -->
                    <Button Text="Sign In"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="48"
                            Margin="0,8,0,0" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#512BD4"
                                       HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Quick Demo Login Helper Card -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="#D1C4E9"
                    StrokeThickness="1"
                    BackgroundColor="#F3E5F5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⚡ Quick Demo Logins (Seed Accounts)"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#4A148C" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="🎓 Student"
                                FontSize="11"
                                Padding="4"
                                BackgroundColor="#7E57C2"
                                TextColor="White"
                                CornerRadius="6"
                                Command="{Binding QuickLoginStudentCommand}" />

                        <Button Grid.Column="1"
                                Text="🚴 Courier"
                                FontSize="11"
                                Padding="4"
                                BackgroundColor="#26A69A"
                                TextColor="White"
                                CornerRadius="6"
                                Command="{Binding QuickLoginCourierCommand}" />

                        <Button Grid.Column="2"
                                Text="👨‍🍳 Café Owner"
                                FontSize="11"
                                Padding="4"
                                BackgroundColor="#FF7043"
                                TextColor="White"
                                CornerRadius="6"
                                Command="{Binding QuickLoginCafeOwnerCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sign Up Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,10,0,20">
                <Label Text="Don't have an account?"
                       FontSize="14"
                       TextColor="#666666" />
                <Label Text="Create Account"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#512BD4">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
