<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             x:Class="CampusBite.Views.CafeListPage"
             x:DataType="vm:CafeListViewModel"
             Title="{Binding Title}"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*">

        <!-- Top Header Banner -->
        <VerticalStackLayout Grid.Row="0" Padding="20,15,20,10" Spacing="4" BackgroundColor="#512BD4">
            <Label Text="CampusBite ☕" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White" />
            <Label Text="Discover nearby cafés &amp; order ahead" 
                   FontSize="13" 
                   TextColor="#E0D0FF" />
        </VerticalStackLayout>

        <!-- Cafes Collection List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsBusy}" 
                     Command="{Binding LoadCafesCommand}">
            
            <CollectionView ItemsSource="{Binding Cafes}"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="30">
                        <Label Text="No Cafés Found" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Pull down to refresh campus cafés list" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Cafe">
                        <Grid Padding="15,8">
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    Padding="15">
                                
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CafeListViewModel}}, Path=SelectCafeCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">

                                    <!-- Café Thumbnail / Icon -->
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 10"
                                            HeightRequest="70"
                                            WidthRequest="70"
                                            BackgroundColor="#F0EBFF"
                                            Padding="10"
                                            StrokeThickness="0">
                                        <Image Source="{Binding ImageUrl}" 
                                               Aspect="AspectFit" />
                                    </Border>

                                    <!-- Café Details -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        
                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Name -->
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="#1F1F1F" 
                                                   LineBreakMode="TailTruncation" />

                                            <!-- Status Badge (Open / Closed) -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="8,3"
                                                    HorizontalOptions="End"
                                                    StrokeThickness="0">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#E6F4EA" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="#FCE8E6" />
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Label FontSize="11" FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOpen}" Value="True">
                                                            <Setter Property="Text" Value="OPEN" />
                                                            <Setter Property="TextColor" Value="#137333" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsOpen}" Value="False">
                                                            <Setter Property="Text" Value="CLOSED" />
                                                            <Setter Property="TextColor" Value="#C5221F" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <Label Text="{Binding Description}" 
                                               FontSize="12" 
                                               TextColor="#5F6368" 
                                               MaxLines="2" 
                                               LineBreakMode="TailTruncation" />

                                        <!-- Location -->
                                        <HorizontalStackLayout Spacing="4" Margin="0,2,0,0">
                                            <Label Text="📍" FontSize="11" />
                                            <Label Text="{Binding Location}" 
                                                   FontSize="11" 
                                                   TextColor="#70757A" 
                                                   FontAttributes="Italic" />
                                        </HorizontalStackLayout>

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>
