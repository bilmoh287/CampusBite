<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models"
             x:Class="CampusBite.Views.DeliveryRunnerPage"
             x:DataType="vm:DeliveryRunnerViewModel"
             Title="Campus Courier 🛵"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto, *">

        <!-- Row 0: Courier Dashboard & Status Header -->
        <Border Grid.Row="0" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
            <VerticalStackLayout Spacing="12">
                <!-- Title & Refresh Row -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Courier Dispatch Hub" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Deliver orders across campus and earn $2.50 per run." FontSize="12" TextColor="#AAAAAA"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="🔄 Refresh"
                            Command="{Binding LoadDeliveriesCommand}"
                            BackgroundColor="#2C2C2C"
                            TextColor="#FF9800"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="8"
                            Padding="12,6"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- Metric Stats Cards -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <!-- Ready for Pickup -->
                    <Border Grid.Column="0" BackgroundColor="#222222" Stroke="#333333" StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ready" FontSize="11" TextColor="#AAAAAA"/>
                            <Label Text="{Binding ReadyCount}" FontSize="18" FontAttributes="Bold" TextColor="#FF9800"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- In Transit -->
                    <Border Grid.Column="1" BackgroundColor="#222222" Stroke="#333333" StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="En Route" FontSize="11" TextColor="#AAAAAA"/>
                            <Label Text="{Binding InTransitCount}" FontSize="18" FontAttributes="Bold" TextColor="#2196F3"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Completed / Earnings -->
                    <Border Grid.Column="2" BackgroundColor="#222222" Stroke="#333333" StrokeThickness="1" Padding="10,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Earned 💰" FontSize="11" TextColor="#AAAAAA"/>
                            <Label Text="{Binding EarningsToday, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#4CAF50"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Live Campus Cafés Status Chips -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Campus Eateries Live Status:" FontSize="11" FontAttributes="Bold" TextColor="#888888"/>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CampusCafes}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Cafe">
                                    <Border BackgroundColor="#222222" Stroke="#333333" StrokeThickness="1" Padding="10,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Border StrokeShape="RoundRectangle 4" HeightRequest="8" WidthRequest="8" StrokeThickness="0" VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsOpen}" Value="False">
                                                        <Setter Property="BackgroundColor" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Border.Triggers>
                                            </Border>
                                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                            <Label FontSize="10" FontAttributes="Bold" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Text" Value="OPEN"/>
                                                        <Setter Property="TextColor" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsOpen}" Value="False">
                                                        <Setter Property="Text" Value="CLOSED"/>
                                                        <Setter Property="TextColor" Value="#F44336"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Filter Tabs -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                    <!-- Tab 1: All -->
                    <Button Grid.Column="0"
                            Text="All"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="All"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="36">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterAll}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF9800"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterAll}" Value="False">
                                <Setter Property="BackgroundColor" Value="#252525"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Tab 2: Ready -->
                    <Button Grid.Column="1"
                            Text="Ready"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Ready"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="36">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterReady}" Value="True">
                                <Setter Property="BackgroundColor" Value="#FF9800"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterReady}" Value="False">
                                <Setter Property="BackgroundColor" Value="#252525"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Tab 3: En Route -->
                    <Button Grid.Column="2"
                            Text="En Route"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Out for Delivery"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="36">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterInTransit}" Value="True">
                                <Setter Property="BackgroundColor" Value="#2196F3"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterInTransit}" Value="False">
                                <Setter Property="BackgroundColor" Value="#252525"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- Tab 4: Delivered -->
                    <Button Grid.Column="3"
                            Text="Delivered"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Delivered"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            FontSize="11"
                            HeightRequest="36">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterDelivered}" Value="True">
                                <Setter Property="BackgroundColor" Value="#4CAF50"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFilterDelivered}" Value="False">
                                <Setter Property="BackgroundColor" Value="#252525"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Row 1: Delivery Order Tickets List -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDeliveriesCommand}"
                     RefreshColor="#FF9800"
                     BackgroundColor="#121212">

            <CollectionView ItemsSource="{Binding Deliveries}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="30">
                        <Label Text="🛵" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="No Deliveries in Queue" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="There are no orders matching the selected filter. Pull down to refresh or check back soon!"
                               FontSize="14"
                               TextColor="#888888"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Grid Padding="16,6">
                            <Border BackgroundColor="#1E1E1E" Stroke="#333333" StrokeThickness="1" Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">
                                    <!-- Ticket Header Row -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Id, StringFormat='Delivery #{0}'}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                                <Label Text="{Binding OrderDate, StringFormat='• {0:t}'}" FontSize="13" TextColor="#AAAAAA" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Cafe.Name, StringFormat='Pickup: {0}'}" FontSize="13" FontAttributes="Bold" TextColor="#FF9800"/>
                                        </VerticalStackLayout>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" StrokeThickness="1" Padding="10,4" VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Ready">
                                                    <Setter Property="BackgroundColor" Value="#2C2415"/>
                                                    <Setter Property="Stroke" Value="#FF9800"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Out for Delivery">
                                                    <Setter Property="BackgroundColor" Value="#102538"/>
                                                    <Setter Property="Stroke" Value="#2196F3"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivered">
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="Stroke" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="Stroke" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Ready">
                                                        <Setter Property="TextColor" Value="#FF9800"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Out for Delivery">
                                                        <Setter Property="TextColor" Value="#2196F3"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivered">
                                                        <Setter Property="TextColor" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="TextColor" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </Grid>

                                    <!-- Drop-off Destination Card -->
                                    <Border BackgroundColor="#162332" Stroke="#2196F3" StrokeThickness="1" Padding="10,6">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="Drop-off Destination:" FontSize="11" FontAttributes="Bold" TextColor="#2196F3" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding DeliveryLocation, FallbackValue='Campus Location'}" FontSize="13" TextColor="White" Margin="18,0,0,0"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Special Instructions (If any) -->
                                    <Border BackgroundColor="#2D2B1E" Stroke="#FFC107" StrokeThickness="1" Padding="10,6" IsVisible="{Binding HasNotes}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="📝" FontSize="11" VerticalOptions="Center"/>
                                            <Label Text="{Binding Notes}" FontSize="12" TextColor="#CCCCCC" FontAttributes="Italic" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Itemized Preview -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrderItems}" Spacing="2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:OrderItem">
                                                <Grid ColumnDefinitions="*, Auto" Padding="0,2">
                                                    <Label Grid.Column="0" Text="{Binding Product.Name}" FontSize="12" TextColor="#888888"/>
                                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="12" TextColor="#AAAAAA"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="1" Color="#2A2A2A"/>

                                    <!-- Action Row: Courier Fee & Next Action Button -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                            <Label Text="Courier Fee Earned" FontSize="10" TextColor="#888888"/>
                                            <Label Text="+$2.50" FontSize="16" FontAttributes="Bold" TextColor="#4CAF50"/>
                                        </VerticalStackLayout>

                                        <!-- Contextual Action Buttons -->
                                        <!-- If Ready: Pick Up Button -->
                                        <Button Grid.Column="1"
                                                Text="Pick Up Order 🛵"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeliveryRunnerViewModel}}, Path=AdvanceDeliveryStatusCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FF9800"
                                                TextColor="Black"
                                                FontAttributes="Bold"
                                                CornerRadius="16"
                                                Padding="16,6"
                                                FontSize="12"
                                                IsVisible="{Binding Status, Converter={x:Null}}">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Ready">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                    <Setter Property="Text" Value="Pick Up Order 🛵"/>
                                                    <Setter Property="BackgroundColor" Value="#FF9800"/>
                                                    <Setter Property="TextColor" Value="Black"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Out for Delivery">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                    <Setter Property="Text" Value="Confirm Drop-off 🏁"/>
                                                    <Setter Property="BackgroundColor" Value="#2196F3"/>
                                                    <Setter Property="TextColor" Value="White"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Delivered">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                    <Setter Property="Text" Value="Delivered ✔️"/>
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="TextColor" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                    <Setter Property="Text" Value="Delivered ✔️"/>
                                                    <Setter Property="BackgroundColor" Value="#1A3826"/>
                                                    <Setter Property="TextColor" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Preparing">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
