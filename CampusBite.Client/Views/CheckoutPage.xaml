<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CampusBite.ViewModels"
             xmlns:models="clr-namespace:CampusBite.Models.UI"
             x:Class="CampusBite.Views.CheckoutPage"
             x:DataType="viewmodels:CheckoutViewModel"
             Title="Checkout"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*, Auto">

        <!-- Scrollable Checkout Form -->
        <ScrollView Grid.Row="0" Padding="16">
            <VerticalStackLayout Spacing="20">

                <!-- Header Banner -->
                <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Finalize Your Order 📝" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Select order type, payment method, and review your item summary." FontSize="13" TextColor="#AAAAAA"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Dining Mode (Dine-In, Pickup, Delivery) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Dining Mode" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <!-- Dine-In Option -->
                        <Border Grid.Column="0"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="1"
                                Stroke="#333333"
                                Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDineInSelected}" Value="True">
                                    <Setter Property="Stroke" Value="#FF9800" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#2A1F10" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectOrderTypeCommand}" CommandParameter="DineIn"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="🍽️ Dine-In" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="Eat at Table" FontSize="10" TextColor="#AAAAAA" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Pickup Option -->
                        <Border Grid.Column="1"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="1"
                                Stroke="#333333"
                                Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPickupSelected}" Value="True">
                                    <Setter Property="Stroke" Value="#FF9800" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#2A1F10" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectOrderTypeCommand}" CommandParameter="Pickup"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="🚶 Pickup" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="Counter To-Go" FontSize="10" TextColor="#AAAAAA" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Delivery Option -->
                        <Border Grid.Column="2"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="1"
                                Stroke="#333333"
                                Padding="8,10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsDeliverySelected}" Value="True">
                                    <Setter Property="Stroke" Value="#FF9800" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#2A1F10" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectOrderTypeCommand}" CommandParameter="Delivery"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="🛵 Delivery" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="+15 ETB fee" FontSize="10" TextColor="#FF9800" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Dine-In Notice -->
                    <Label Text="🍽️ Food will be served on ceramic café plates. Zero packaging fees."
                           FontSize="11"
                           TextColor="#81C784"
                           IsVisible="{Binding IsDineInSelected}"/>

                    <!-- Progressive Disclosure: Packaging Choice (Only if Takeaway/Delivery AND Cafe charges for boxes) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowPackagingChoice}" Margin="0,4,0,0">
                        <Label Text="Takeaway Packaging Preference" FontSize="13" FontAttributes="Bold" TextColor="#CCCCCC"/>
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <!-- Free Festal / Wrap -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#1E1E1E"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsStandardPackagingSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#4CAF50" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="BackgroundColor" Value="#1A2E1A" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectPackagingOptionCommand}" CommandParameter="StandardFree"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="🛍️ Festal / Wrap" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="Free (0 ETB)" FontSize="10" TextColor="#4CAF50" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Sturdy Takeaway Box -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#1E1E1E"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    Padding="10,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsTakeawayBoxSelected}" Value="True">
                                        <Setter Property="Stroke" Value="#FF9800" />
                                        <Setter Property="StrokeThickness" Value="2" />
                                        <Setter Property="BackgroundColor" Value="#2A1F10" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectPackagingOptionCommand}" CommandParameter="TakeawayBox"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="📦 Sturdy Box" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="{Binding TakeawayBoxPriceText}" FontSize="10" TextColor="#FF9800" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Campus Delivery Location Input (Conditional) -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsDeliverySelected}">
                    <Label Text="Campus Delivery Location" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                    <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding DeliveryLocation}"
                               Placeholder="e.g. Science Building, 2nd Floor Room 204"
                               PlaceholderColor="#666666"
                               TextColor="White"
                               FontSize="14"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Payment Method Selection -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Payment Method" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <!-- Cash Option -->
                        <Border Grid.Column="0"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="1"
                                Stroke="#333333"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCashSelected}" Value="True">
                                    <Setter Property="Stroke" Value="#4CAF50" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#17281A" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="💵 Cash" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="Pay on drop-off/counter" FontSize="11" TextColor="#AAAAAA" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Meal Contract Pass Option -->
                        <Border Grid.Column="1"
                                BackgroundColor="#1E1E1E"
                                StrokeThickness="1"
                                Stroke="#333333"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsContractSelected}" Value="True">
                                    <Setter Property="Stroke" Value="#9C27B0" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <Setter Property="BackgroundColor" Value="#29152C" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPaymentMethodCommand}" CommandParameter="MealContract"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="🍱 Meal Pass" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Label Text="Prepaid Credits / Tab" FontSize="11" TextColor="#CE93D8" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Active Meal Contract Details (Visible when Meal Pass Selected) -->
                <Border BackgroundColor="#1E1E1E"
                        StrokeThickness="1"
                        Stroke="#9C27B0"
                        Padding="14"
                        IsVisible="{Binding IsContractSelected}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Active Dining Contract" FontSize="14" FontAttributes="Bold" TextColor="#CE93D8"/>
                                <Label Text="{Binding ContractSummaryText}" FontSize="12" TextColor="#CCCCCC"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#3A1C40" StrokeThickness="0" Padding="8,4" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding AvailableCredits, StringFormat='{0} Credits'}" FontSize="12" FontAttributes="Bold" TextColor="#E1BEE7"/>
                            </Border>
                        </Grid>

                        <!-- Credits Coverage Note -->
                        <Label Text="{Binding CoveredMealsCount, StringFormat='🍱 {0} meal(s) in this order will be covered by your contract credits.'}"
                               FontSize="12"
                               TextColor="#81C784"
                               FontAttributes="Bold"
                               IsVisible="{Binding HasDiscount}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Special Notes Input -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Special Instructions / Notes (Optional)" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                    <Border BackgroundColor="#1E1E1E" StrokeThickness="1" Stroke="#333333" Padding="12,4">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding Notes}"
                               Placeholder="e.g. Extra napkins, please call upon arrival"
                               PlaceholderColor="#666666"
                               TextColor="White"
                               FontSize="14"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Table Buddies & Pass Split Card (Visible for 2+ items or Meal Pass) -->
                <Border BackgroundColor="#1A2130"
                        StrokeThickness="1"
                        Stroke="#3F51B5"
                        Padding="14"
                        IsVisible="{Binding HasGroupOrder}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Text="👥" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Dining Buddies &amp; Multi-Pass Split" FontSize="14" FontAttributes="Bold" TextColor="#90CAF9"/>
                                <Label Text="Tag friends at your table. Their active passes will deduct 1 meal each." FontSize="11" TextColor="#B0BEC5"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Add Buddy Tag Input -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="#111822" StrokeThickness="1" Stroke="#455A64" Padding="10,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Grid.Column="0" Text="@" TextColor="#90CAF9" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" Margin="0,0,4,0"/>
                                    <Entry Grid.Column="1" 
                                           Text="{Binding BuddySearchInput}" 
                                           Placeholder="friend_username" 
                                           PlaceholderColor="#607D8B" 
                                           TextColor="White" 
                                           FontSize="13" 
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Text="Tag Friend ➕"
                                    Command="{Binding AddCoDinerCommand}"
                                    IsEnabled="{Binding CanAddMoreCoDiners}"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    CornerRadius="8"
                                    Padding="12,0"
                                    HeightRequest="38"/>
                        </Grid>

                        <!-- Tagged Co-Diners Chips List -->
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SelectedCoDinerUsernames}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border BackgroundColor="#0D47A1" StrokeThickness="1" Stroke="#64B5F6" Padding="10,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14"/>
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding StringFormat='@{0}'}" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                            <Button Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CheckoutViewModel}}, Path=RemoveCoDinerCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#FF8A80"
                                                    FontAttributes="Bold"
                                                    FontSize="11"
                                                    Padding="0"
                                                    HeightRequest="20"
                                                    WidthRequest="20"
                                                    VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Items Review Summary & Smart Pass Split Breakdown -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Smart Bill &amp; Upgrade Breakdown" FontSize="16" FontAttributes="Bold" TextColor="#FF9800"/>
                    <Border BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">

                            <!-- Individual Dish Coverage Breakdown -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SplitCoverageDetails}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:OrderCoverDetail">
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="2">
                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding ItemName}" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding StatusBadge}" FontSize="13" FontAttributes="Bold" TextColor="#81C784"/>
                                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                                <Label Text="{Binding UnitPrice, StringFormat='Price: {0:F0} ETB •'}" FontSize="11" TextColor="#888888"/>
                                                <Label Text="{Binding CoveredBy, StringFormat='Covered by: {0}'}" FontSize="11" FontAttributes="Italic" TextColor="#CE93D8"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#333333"/>

                            <!-- Bill Breakdown -->
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0" Text="Subtotal (Menu Value)" FontSize="13" TextColor="#AAAAAA"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat='{0:F2} ETB'}" FontSize="13" TextColor="White"/>

                                <!-- Meal Pass Discount Row -->
                                <Label Grid.Row="1" Grid.Column="0" Text="Pass Credits Applied" FontSize="13" TextColor="#81C784" IsVisible="{Binding HasDiscount}"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-{0:F2} ETB'}" FontSize="13" FontAttributes="Bold" TextColor="#81C784" IsVisible="{Binding HasDiscount}"/>

                                <!-- Packaging Fee Row (Visible when Packaging Box is chosen) -->
                                <Label Grid.Row="2" Grid.Column="0" Text="Takeaway Box Fee" FontSize="13" TextColor="#AAAAAA" IsVisible="{Binding IsTakeawayBoxSelected}"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding PackagingFee, StringFormat='{0:F2} ETB'}" FontSize="13" TextColor="White" IsVisible="{Binding IsTakeawayBoxSelected}"/>

                                <Label Grid.Row="3" Grid.Column="0" Text="Delivery Fee" FontSize="13" TextColor="#AAAAAA" IsVisible="{Binding IsDeliverySelected}"/>
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding DeliveryFee, StringFormat='{0:F2} ETB'}" FontSize="13" TextColor="White" IsVisible="{Binding IsDeliverySelected}"/>

                                <Label Grid.Row="4" Grid.Column="0" Text="Total Cash Due" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{0:F2} ETB'}" FontSize="18" FontAttributes="Bold" TextColor="#FF9800"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Group Dining Split Bill Card (Visible for 2+ items) -->
                <Border BackgroundColor="#1E2836"
                        StrokeThickness="1"
                        Stroke="#2196F3"
                        Padding="14"
                        IsVisible="{Binding HasGroupOrder}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" Text="👥" FontSize="20" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Group Split Bill Helper" FontSize="13" FontAttributes="Bold" TextColor="#64B5F6"/>
                            <Label Text="{Binding PerPersonShareText}" FontSize="12" TextColor="#E3F2FD"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Action Bar (Fixed at bottom) -->
        <Border Grid.Row="1" BackgroundColor="#1E1E1E" StrokeThickness="0" Padding="16">
            <Button Text="Place Order"
                    Command="{Binding PlaceOrderCommand}"
                    IsEnabled="{Binding IsNotProcessing}"
                    BackgroundColor="#FF9800"
                    TextColor="#121212"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="52"/>
        </Border>

    </Grid>

</ContentPage>
